---
import type { Locale } from '../../i18n/utils';
import { t } from '../../i18n/utils';
import { differentials } from '../../data/differentials';
import SectionHeading from '../atoms/SectionHeading.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const iconMap: Record<string, string> = {
  architecture: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>',
  leadership: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
  ai: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2a4 4 0 0 0-4 4v2H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V10a2 2 0 0 0-2-2h-2V6a4 4 0 0 0-4-4z"/><circle cx="9" cy="14" r="1"/><circle cx="15" cy="14" r="1"/></svg>',
  legacy: '<svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"/><path d="M16 16h5v5"/></svg>',
};
---

<section class="section differentials reveal-stagger" id="differentials">
  <div class="section__container">
    <SectionHeading
      title={t(locale, 'differentials.title')}
      subtitle={t(locale, 'differentials.subtitle')}
      numbered="05."
    />

    <div class="differentials__grid">
      {differentials.map((diff) => (
        <div class="differentials__card">
          <div class="differentials__icon" set:html={iconMap[diff.icon] || ''} />
          <h3 class="differentials__title">
            {locale === 'pt' ? diff.title : diff.titleEn}
          </h3>
          <p class="differentials__description">
            {locale === 'pt' ? diff.description : diff.descriptionEn}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .differentials__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .differentials__card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    transition: all var(--transition-base);
    position: relative;
    overflow: hidden;
  }

  .differentials__card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--color-accent), var(--color-accent-secondary));
    opacity: 0;
    transition: opacity var(--transition-base);
  }

  .differentials__card:hover {
    border-color: var(--color-accent);
    transform: translateY(-2px);
  }

  .differentials__card:hover::before {
    opacity: 1;
  }

  .differentials__icon {
    color: var(--color-accent);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: color-mix(in srgb, var(--color-accent) 10%, transparent);
    border-radius: var(--radius-badge);
  }

  .differentials__icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .differentials__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .differentials__description {
    color: var(--color-text-secondary);
    font-size: 0.9375rem;
    line-height: 1.6;
    margin: 0;
  }

  @media (max-width: 768px) {
    .differentials__grid {
      grid-template-columns: 1fr;
    }
  }
</style>