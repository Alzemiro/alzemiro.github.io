---
import type { Locale } from '../../i18n/utils';
import { t } from '../../i18n/utils';
import SectionHeading from '../atoms/SectionHeading.astro';
import Badge from '../atoms/Badge.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<section class="section about reveal" id="about">
  <div class="section__container">
    <SectionHeading
      title={t(locale, 'about.title')}
      numbered="01."
    />

    <div class="about__grid">
      <div class="about__text">
        <p class="about__p">{t(locale, 'about.p1')}</p>
        <p class="about__p">{t(locale, 'about.p2')}</p>

        <div class="about__badges">
          <Badge text={t(locale, 'about.badge')} variant="accent" size="md" />
          <Badge text={t(locale, 'about.available')} variant="success" size="md" />
          <Badge text={t(locale, 'about.languages')} variant="default" size="md" />
        </div>
      </div>

      <div class="about__image">
        <div class="about__photo-wrapper">
          <img
            src="/images/20250519_122224.jpg"
            alt="Alzemiro Iago"
            class="about__photo"
            width="280"
            height="340"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about__grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4rem;
    align-items: start;
  }

  .about__text {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .about__subtitle {
    font-size: 1.125rem;
    color: var(--color-accent);
    font-weight: 500;
    margin: 0;
  }

  .about__p {
    color: var(--color-text-secondary);
    line-height: 1.7;
    margin: 0;
  }

  .about__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .about__image {
    flex-shrink: 0;
  }

  .about__photo-wrapper {
    width: 280px;
    height: 340px;
    border-radius: var(--radius-card);
    overflow: hidden;
    border: 2px solid var(--color-border);
    position: relative;
    transition: border-color var(--transition-base);
  }

  .about__photo-wrapper:hover {
    border-color: var(--color-accent);
  }

  .about__photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    filter: contrast(1.05) brightness(1.02) saturate(0.9);
    transition: filter var(--transition-base);
  }

  .about__photo-wrapper:hover .about__photo {
    filter: contrast(1.08) brightness(1.04) saturate(0.95);
  }

  @media (max-width: 768px) {
    .about__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about__image {
      display: flex;
      justify-content: center;
    }

    .about__photo-wrapper {
      width: 220px;
      height: 270px;
    }
  }
</style>