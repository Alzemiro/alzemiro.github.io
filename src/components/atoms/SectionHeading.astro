---
interface Props {
  title: string;
  subtitle?: string;
  numbered?: string;
}

const { title, subtitle, numbered } = Astro.props;
---

<div class="section-heading">
  {numbered && <span class="section-heading__number">{numbered}</span>}
  <h2 class="section-heading__title">{title}</h2>
  {subtitle && <p class="section-heading__subtitle">{subtitle}</p>}
</div>